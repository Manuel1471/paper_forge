          145,
          120,
          110,
          116
        ],
        "repeat_header": true,
        "style": "table_compact"
      }
    },
    {
      "type": "heading",
      "text": "Capacidad para crecer",
      "options": {
        "style": "section",
        "size": 16,
        "line_height": 21,
        "space_after": 10
      }
    },
    {
      "type": "paragraph",
      "text": "Las cifras acompañan una decisión concreta: aumentar la frecuencia donde la demanda es estable y reservar capacidad para las horas de mayor variación.",
      "options": {
        "style": "body"
      }
    },
    {
      "type": "chart",
      "content": [
