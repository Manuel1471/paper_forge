    {
      "type": "svg",
      "content": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 491 690\"><text x=\"0\" y=\"10\" font-size=\"8\" fill=\"#087F83\" font-weight=\"normal\">CUADERNO DE DISEÑO / 06</text><text x=\"0\" y=\"54\" font-size=\"24\" fill=\"#183B45\" font-weight=\"bold\">Una revisión clara y sencilla</text><text x=\"0\" y=\"82\" font-size=\"10\" fill=\"#557177\" font-weight=\"normal\">Completa los datos, elige un estado y confirma la revisión.</text><line x1=\"0\" y1=\"104\" x2=\"491\" y2=\"104\" stroke=\"#DCE6E6\" stroke-width=\"0.6\"/><text x=\"0\" y=\"132\" font-size=\"9\" fill=\"#087F83\" font-weight=\"bold\">01  DATOS DE LA REVISIÓN</text><text x=\"0\" y=\"158\" font-size=\"9\" fill=\"#557177\" font-weight=\"normal\">Nombre</text><text x=\"254\" y=\"158\" font-size=\"9\" fill=\"#557177\" font-weight=\"normal\">Área</text><text x=\"0\" y=\"216\" font-size=\"9\" fill=\"#557177\" font-weight=\"normal\">Presupuesto</text><text x=\"254\" y=\"216\" font-size=\"9\" fill=\"#557177\" font-weight=\"normal\">País</text><line x1=\"0\" y1=\"266\" x2=\"491\" y2=\"266\" stroke=\"#DCE6E6\" stroke-width=\"0.6\"/><text x=\"0\" y=\"295\" font-size=\"9\" fill=\"#087F83\" font-weight=\"bold\">02  RESULTADO</text><text x=\"20\" y=\"325\" font-size=\"9.5\" fill=\"#183B45\" font-weight=\"normal\">Aprobado</text><text x=\"197\" y=\"325\" font-size=\"9.5\" fill=\"#183B45\" font-weight=\"normal\">Requiere ajustes</text><text x=\"20\" y=\"357\" font-size=\"9.5\" fill=\"#183B45\" font-weight=\"normal\">Confirmo que revisé los datos y las referencias.</text><line x1=\"0\" y1=\"383\" x2=\"491\" y2=\"383\" stroke=\"#DCE6E6\" stroke-width=\"0.6\"/><text x=\"0\" y=\"412\" font-size=\"9\" fill=\"#087F83\" font-weight=\"bold\">03  CONFORMIDAD</text><text x=\"0\" y=\"439\" font-size=\"9\" fill=\"#557177\" font-weight=\"normal\">Firma</text><text x=\"0\" y=\"495\" font-size=\"8\" fill=\"#557177\" font-weight=\"normal\">Se completa en un lector compatible. Esta muestra no está firmada.</text><line x1=\"0\" y1=\"526\" x2=\"491\" y2=\"526\" stroke=\"#DCE6E6\" stroke-width=\"0.6\"/><text x=\"0\" y=\"556\" font-size=\"8\" fill=\"#087F83\" font-weight=\"bold\">QUÉ REVISAMOS</text><text x=\"0\" y=\"583\" font-size=\"10\" fill=\"#183B45\" font-weight=\"bold\">Contenido</text><text x=\"0\" y=\"602\" font-size=\"8\" fill=\"#557177\" font-weight=\"normal\">Datos y conclusiones</text><text x=\"175\" y=\"583\" font-size=\"10\" fill=\"#183B45\" font-weight=\"bold\">Consistencia</text><text x=\"175\" y=\"602\" font-size=\"8\" fill=\"#557177\" font-weight=\"normal\">Unidades y periodos</text><text x=\"350\" y=\"583\" font-size=\"10\" fill=\"#183B45\" font-weight=\"bold\">Referencias</text><text x=\"350\" y=\"602\" font-size=\"8\" fill=\"#557177\" font-weight=\"normal\">Fuentes y notas</text><text x=\"0\" y=\"649\" font-size=\"8\" fill=\"#557177\" font-weight=\"normal\">Demostración: Lucía Peña · México · € · “Conforme”</text></svg>",
