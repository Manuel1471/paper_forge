    {
      "type": "paragraph",
      "text": "La calidad se comprueba en el contenido, en la estructura y en la experiencia de lectura.",
      "options": {
        "style": "body",
        "size": 10,
        "line_height": 15,
        "space_after": 16
      }
    },
