{
  "version": "1",
  "kind": "component",
  "name": "metrics_section",
  "components": ["metric_line.paperforge"],
  "props": {
    "title": {"type": "string", "required": true, "max_length": 80},
    "metrics": {
      "type": "list",
      "required": true,
      "min_length": 1,
      "max_length": 8,
      "items": {
        "type": "map",
        "required_properties": ["label", "value", "change"],
        "properties": {
          "label": {"type": "string"},
          "value": {"type": "string"},
          "change": {"type": "string"}
        }
      }
    }
  },
  "slots": {
    "after": {"required": false}
  },
  "blocks": [
    {
      "type": "heading",
      "text": "{{title}}",
      "options": {"style": "section"}
    },
    {
      "for": "metric in metrics",
      "blocks": [
        {
          "component": "metric_line",
          "props": {
            "label": "{{metric.label}}",
            "value": "{{metric.value}}",
            "change": "{{metric.change}}"
          }
        }
      ]
    },
    {"slot": "after"}
  ]
}
