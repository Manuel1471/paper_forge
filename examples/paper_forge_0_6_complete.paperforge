{
  "version": "1",
  "variables": {
    "company": {"type": "string", "required": true, "min_length": 2, "max_length": 80},
    "year": {"type": "string", "required": true, "pattern": "^[0-9]{4}$"},
    "cover_title": {"type": "string", "required": true},
    "review_label": {"type": "string", "required": true},
    "summary": {"type": "string", "required": true},
    "headline": {"type": "string", "required": true},
    "headline_revenue": {"type": "string", "required": true},
    "headline_growth": {"type": "string", "required": true},
    "performance_summary": {"type": "string", "required": true},
    "metrics": {"type": "list", "required": true, "min_length": 3, "max_length": 3, "items": {"type": "map"}},
    "chart": {"type": "list", "required": true, "min_length": 4, "max_length": 4, "items": {"type": "list", "min_length": 2, "max_length": 2}},
    "portfolio_revenue": {"type": "string", "required": true},
    "portfolio_growth": {"type": "string", "required": true},
    "rows": {"type": "list", "required": true, "min_length": 8, "max_length": 20, "items": {"type": "list", "min_length": 5, "max_length": 5}},
    "survey_url": {"type": "string", "required": true, "format": "url"},
    "survey_intro": {"type": "string", "required": true},
    "report_id": {"type": "string", "required": true},
    "attachment_name": {"type": "string", "required": true},
    "attachment_description": {"type": "string", "required": true},
    "source_csv": {"type": "string", "required": true},
    "scale_copy": {"type": "string", "required": true},
    "trust_copy": {"type": "string", "required": true},
    "horizon_copy": {"type": "string", "required": true},
    "operating_signal": {"type": "string", "required": true},
    "driver_left_title": {"type": "string", "required": true},
    "driver_left_copy": {"type": "string", "required": true},
    "driver_right_title": {"type": "string", "required": true},
    "driver_right_copy": {"type": "string", "required": true},
    "portfolio_summary": {"type": "string", "required": true},
    "portfolio_read": {"type": "string", "required": true}
  },
  "design_system": {
    "components": {
      "complete_report": {
        "props": {
          "company": {"type": "string", "required": true},
          "year": {"type": "string", "required": true},
          "headline_revenue": {"type": "string", "required": true}
        },
        "blocks": []
      }
    }
  },
  "blocks": [
    {
      "component": "complete_report",
      "props": {
        "company": "{{company}}",
        "year": "{{year}}",
        "headline_revenue": "{{headline_revenue}}"
      }
    }
  ]
}
