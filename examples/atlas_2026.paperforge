        {
          "content": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 595 842\"><rect x=\"0\" y=\"0\" width=\"595\" height=\"842\" fill=\"#132733\"/>\n<rect x=\"48\" y=\"65\" width=\"40\" height=\"5\" fill=\"#E16647\"/>\n<text x=\"48\" y=\"118\" font-size=\"38\" fill=\"#FFFFFF\">ATLAS</text>\n<text x=\"50\" y=\"143\" font-size=\"9\" fill=\"#9AC2BE\">LOGÍSTICA / INFORME ANUAL</text>\n<text x=\"48\" y=\"239\" font-size=\"49\" fill=\"#FFFFFF\">La distancia</text>\n<text x=\"48\" y=\"296\" font-size=\"49\" fill=\"#FFFFFF\">se convierte</text>\n<text x=\"48\" y=\"353\" font-size=\"49\" fill=\"#FFFFFF\">en confianza.</text>\n<text x=\"48\" y=\"426\" font-size=\"32\" fill=\"#E16647\">2026</text>\n<line x1=\"89.6\" y1=\"536.75\" x2=\"173.2\" y2=\"481.4\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"89.6\" y1=\"536.75\" x2=\"186.4\" y2=\"604.4\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"173.2\" y1=\"481.4\" x2=\"274.4\" y2=\"542.9\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"186.4\" y1=\"604.4\" x2=\"274.4\" y2=\"542.9\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"186.4\" y1=\"604.4\" x2=\"322.79999999999995\" y2=\"639.25\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"274.4\" y1=\"542.9\" x2=\"388.8\" y2=\"503.95\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"274.4\" y1=\"542.9\" x2=\"441.59999999999997\" y2=\"592.1\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"322.79999999999995\" y1=\"639.25\" x2=\"441.59999999999997\" y2=\"592.1\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"388.8\" y1=\"503.95\" x2=\"498.8\" y2=\"538.8\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<line x1=\"441.59999999999997\" y1=\"592.1\" x2=\"498.8\" y2=\"538.8\" stroke=\"#00736E\" stroke-width=\"2\"/>\n<circle cx=\"89.6\" cy=\"536.75\" r=\"8\" fill=\"#E16647\"/>\n<text x=\"83.6\" y=\"562.75\" font-size=\"9\" fill=\"#5B6F76\">01</text>\n<circle cx=\"173.2\" cy=\"481.4\" r=\"8\" fill=\"#E16647\"/>\n<text x=\"167.2\" y=\"507.4\" font-size=\"9\" fill=\"#5B6F76\">02</text>\n<circle cx=\"186.4\" cy=\"604.4\" r=\"8\" fill=\"#E16647\"/>\n<text x=\"180.4\" y=\"630.4\" font-size=\"9\" fill=\"#5B6F76\">03</text>\n<circle cx=\"274.4\" cy=\"542.9\" r=\"8\" fill=\"#E16647\"/>\n<text x=\"268.4\" y=\"568.9\" font-size=\"9\" fill=\"#5B6F76\">04</text>\n<circle cx=\"322.79999999999995\" cy=\"639.25\" r=\"8\" fill=\"#E16647\"/>\n<text x=\"316.79999999999995\" y=\"665.25\" font-size=\"9\" fill=\"#5B6F76\">05</text>\n<circle cx=\"388.8\" cy=\"503.95\" r=\"8\" fill=\"#E16647\"/>\n<text x=\"382.8\" y=\"529.95\" font-size=\"9\" fill=\"#5B6F76\">06</text>\n<circle cx=\"441.59999999999997\" cy=\"592.1\" r=\"8\" fill=\"#E16647\"/>\n<text x=\"435.59999999999997\" y=\"618.1\" font-size=\"9\" fill=\"#5B6F76\">07</text>\n<circle cx=\"498.8\" cy=\"538.8\" r=\"8\" fill=\"#E16647\"/>\n<text x=\"492.8\" y=\"564.8\" font-size=\"9\" fill=\"#5B6F76\">08</text>\n<text x=\"48\" y=\"733\" font-size=\"10\" fill=\"#FFFFFF\">OPERACIÓN  /  PERSONAS  /  IMPACTO</text>\n<text x=\"48\" y=\"766\" font-size=\"9\" fill=\"#9AC2BE\">Edición demostrativa · Datos ficticios · PaperForge 1.5.0</text></svg>",
