{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperforge.dev/schema/paperforge-v1.json",
  "title": "PaperForge Declarative Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "component"}}, "required": ["kind"]},
      "then": {"required": ["name", "blocks"]}
    }
  ],
  "properties": {
    "version": {"const": "1"},
    "id": {"type": "string", "minLength": 1},
    "imports": {"$ref": "#/$defs/pathList"},
    "includes": {"$ref": "#/$defs/pathList"},
    "libraries": {"$ref": "#/$defs/pathList"},
    "components": {"$ref": "#/$defs/pathList"},
    "kind": {"enum": ["component"]},
    "name": {"type": "string", "minLength": 1},
    "props": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/valueSchema"}
    },
    "defaults": {"type": "object"},
    "slots": {"$ref": "#/$defs/slotSchemas"},
    "variants": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/componentVariant"}
    },
    "variables": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/valueSchema"}
    },
    "document": {"type": "object"},
    "metadata": {"type": "object"},
    "security": {"$ref": "#/$defs/security"},
    "signature": {"$ref": "#/$defs/signature"},
    "protection": {"$ref": "#/$defs/protection"},
    "compliance": {"$ref": "#/$defs/compliance"},
    "layout_options": {"type": "object"},
    "page_templates": {"type": "object"},
    "design_system": {"type": "object"},
    "theme": {"type": "string"},
    "layout": {"type": "string"},
    "blocks": {
      "type": "array",
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$defs": {
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "aes_256"},
        "encrypt_metadata": {"type": "boolean"},
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "print": {"enum": ["none", "low_resolution", "high_resolution"]},
            "copy": {"type": "boolean"},
            "modify": {"type": "boolean"},
            "extract": {"type": "boolean"}
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {"enum": ["ps256", "rs256"]},
        "reason": {"type": "string"},
        "location": {"type": "string"},
        "contact_info": {"type": "string"},
        "timestamp": {"type": "boolean"},
        "tsa_url": {"type": "string", "format": "uri"},
        "visible": {"type": "boolean"},
        "multiple": {"type": "boolean"}
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {"type": "string"},
        "modified_at": {"type": "string"},
        "watermark": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "opacity": {"type": "number", "minimum": 0, "maximum": 1},
                "size": {"type": "number", "exclusiveMinimum": 0},
                "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                "angle": {"type": "number"}
              }
            }
          ]
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_uri_schemes": {"type": "array", "items": {"type": "string"}},
            "allowed_hosts": {"type": "array", "items": {"type": "string"}},
            "allow_attachments": {"type": "boolean"},
            "max_attachments": {"type": "integer", "minimum": 0},
            "max_attachment_bytes": {"type": "integer", "minimum": 0},
            "allowed_attachment_mimes": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["pdf_a_2b", "pdf_a_3b", "pdf_ua_1"]}
        },
        "language": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "icc_profile": {"type": "string", "minLength": 1},
        "output_condition": {"type": "string", "minLength": 1}
      }
    },
    "pathList": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1}
    },
    "valueSchema": {
      "oneOf": [
        {"enum": ["any", "string", "number", "integer", "boolean", "list", "map"]},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["any", "string", "number", "integer", "boolean", "list", "map"]},
            "required": {"type": "boolean"},
            "default": {},
            "min": {"type": "number"},
            "max": {"type": "number"},
            "min_length": {"type": "integer", "minimum": 0},
            "max_length": {"type": "integer", "minimum": 0},
            "pattern": {"type": "string"},
            "enum": {"type": "array"},
            "items": {"$ref": "#/$defs/valueSchema"},
            "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/valueSchema"}},
            "required_properties": {"type": "array", "items": {"type": "string"}},
            "additional_properties": {"type": "boolean"},
            "format": {"enum": ["url", "color", "file"]}
          }
        }
      ]
    },
    "slotSchemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"required": {"type": "boolean"}}
      }
    },
    "componentVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {"type": "object"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string"},
        "text": {},
        "content": {},
        "options": {"type": "object"},
        "columns": {},
        "rows": {},
        "min_rows": {"type": "integer", "minimum": 0},
        "max_rows": {"type": "integer", "minimum": 0},
        "cells": {},
        "count": {"type": "integer", "minimum": 1},
        "paragraphs": {},
        "if": {},
        "then": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "else": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "for": {},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "component": {"type": "string"},
        "props": {"type": "object"},
        "variant": {"type": "string"},
        "slots": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/block"}}},
        "slot": {"type": "string"}
      },
      "anyOf": [
        {"required": ["type"]},
        {"required": ["component"]},
        {"required": ["slot"]},
        {"required": ["if"]},
        {"required": ["for"]}
      ]
    }
  }
}
